# Copy to .env and fill in whatever you have. Read by tools/logserver.js and
# handed to the page over localhost, so there is nothing to paste at the door.
#
# .env is gitignored. The keys still end up in the browser — this saves the
# pasting, not the trust — so use keys you are happy to rotate.

# One of: anthropic, openrouter
LG_PROVIDER=openrouter

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Optional: voices. Needs the voices_read permission.
ELEVENLABS_API_KEY=

# Optional. Left blank, the game's own defaults apply.
LG_MODEL=
LG_HELPER=
LG_LANG=
LG_LEVEL=
